<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BiliLiveTool.UI.Views"
        xmlns:vm="clr-namespace:BiliLiveTool.UI.ViewModels"
        x:Class="BiliLiveTool.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BiliLiveTool"
        Icon="avares://BiliLiveTool/Assets/app.ico"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 头部：产品名 + 当前账号 + 全局状态 -->
        <Border Grid.Row="0"
                Padding="14,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardBorderBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Text="BiliLiveTool" />
                    <TextBlock Classes="status"
                               VerticalAlignment="Center"
                               Text="{Binding VersionText}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding IsLoggedIn}">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding CurrentUname}" />
                        <TextBlock Classes="status"
                                   VerticalAlignment="Center"
                                   Text="{Binding CurrentRoomId, StringFormat='房间 {0}'}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Classes="status"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}" />
            </Grid>
        </Border>

        <!-- Tab 结构沿用原前端 -->
        <TabControl Grid.Row="1"
                    Margin="8,4"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="账号">
                <views:AccountView DataContext="{Binding Accounts}" />
            </TabItem>
            <TabItem Header="直播">
                <views:LiveView DataContext="{Binding Live}" />
            </TabItem>
            <TabItem Header="弹幕">
                <views:DanmuView DataContext="{Binding Danmu}" />
            </TabItem>
            <TabItem Header="控制台">
                <views:ConsoleView DataContext="{Binding Console}" />
            </TabItem>
        </TabControl>

        <!-- 统一对话框覆盖层（单实现覆盖全窗） -->
        <ContentControl Grid.Row="0"
                        Grid.RowSpan="3"
                        ZIndex="100"
                        Content="{Binding Dialog.Current}"
                        IsVisible="{Binding Dialog.Current, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Grid>
</Window>
