<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BiliLiveTool.UI.ViewModels"
             x:Class="BiliLiveTool.UI.Views.LiveView"
             x:DataType="vm:LiveViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760"
                    Margin="16"
                    Spacing="12"
                    HorizontalAlignment="Center">
            <TextBlock Classes="status" Text="{Binding StatusText}" />

            <!-- 状态头 -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Classes="section-title"
                               VerticalAlignment="Center"
                               Text="直播控制" />
                    <Border Padding="8,2"
                            CornerRadius="4"
                            Background="#2E7D32"
                            IsVisible="{Binding IsLive}">
                        <TextBlock FontSize="12"
                                   Foreground="White"
                                   Text="直播中" />
                    </Border>
                    <Border Padding="8,2"
                            CornerRadius="4"
                            Background="#757575"
                            IsVisible="{Binding IsOffline}">
                        <TextBlock FontSize="12"
                                   Foreground="White"
                                   Text="未开播" />
                    </Border>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Content="同步信息"
                        Command="{Binding SyncProfileCommand}" />
            </DockPanel>

            <!-- 分区选择（主联动子） -->
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <ComboBox HorizontalAlignment="Stretch"
                          PlaceholderText="主分区"
                          ItemsSource="{Binding ParentNames}"
                          SelectedItem="{Binding SelectedParent}" />
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="子分区"
                          ItemsSource="{Binding ChildNames}"
                          SelectedItem="{Binding SelectedChild}" />
                <Button Grid.Column="2"
                        Content="更新分区"
                        Command="{Binding UpdateAreaCommand}" />
            </Grid>

            <!-- 标题与公告 -->
            <TextBox Classes="input"
                     Watermark="直播标题"
                     Text="{Binding Title}" />
            <Button HorizontalAlignment="Left"
                    Content="保存标题"
                    Command="{Binding UpdateTitleCommand}" />

            <TextBox Classes="input"
                     Watermark="直播公告"
                     Height="84"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding Announcement}" />
            <Button HorizontalAlignment="Left"
                    Content="保存公告"
                    Command="{Binding UpdateAnnouncementCommand}" />

            <!-- 开播 / 停播（对照 doToggle：先标题公告再开播） -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button Classes="primary"
                        Content="开启直播"
                        IsEnabled="{Binding IsIdle}"
                        Command="{Binding StartLiveCommand}" />
                <Button Content="停止直播"
                        IsEnabled="{Binding IsIdle}"
                        Command="{Binding StopLiveCommand}" />
            </StackPanel>

            <!-- 推流码（仅经复制按钮出栈，不给选中路径） -->
            <StackPanel Spacing="4"
                        IsVisible="{Binding HasEndpoints}">
                <TextBlock Classes="section-title" Text="推流码" />
                <ItemsControl ItemsSource="{Binding Endpoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EndpointRow">
                            <Border Classes="dialog-card"
                                    Margin="0,4"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="96,*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="6">
                                    <TextBlock Grid.RowSpan="2"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Text="{Binding Addr}" />
                                    <Button Grid.Column="2"
                                            Content="复制地址"
                                            Command="{Binding CopyCommand}"
                                            CommandParameter="{Binding Addr}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="{Binding Code}" />
                                    <Button Grid.Row="1"
                                            Grid.Column="2"
                                            Content="复制码"
                                            Command="{Binding CopyCommand}"
                                            CommandParameter="{Binding Code}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
