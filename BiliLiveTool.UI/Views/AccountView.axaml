<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BiliLiveTool.UI.ViewModels"
             x:Class="BiliLiveTool.UI.Views.AccountView"
             x:DataType="vm:AccountViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760"
                    Margin="16"
                    Spacing="12"
                    HorizontalAlignment="Center">
            <TextBlock Classes="status" Text="{Binding StatusText}" />

            <!-- 账号列表（对照原 UserAccountModal；返回按钮语义并入收起面板） -->
            <StackPanel Spacing="8">
                <DockPanel>
                    <TextBlock Classes="section-title"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Text="账号列表" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="刷新列表"
                                Command="{Binding RefreshAccountsCommand}" />
                        <Button Classes="primary"
                                Content="添加账号"
                                Command="{Binding AddAccountCommand}" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding AccountItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountItem">
                            <Border Classes="dialog-card"
                                    Margin="0,2"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Uname}" />
                                            <Border Padding="6,1"
                                                    CornerRadius="4"
                                                    Background="#1F00A1D1"
                                                    IsVisible="{Binding IsCurrent}">
                                                <TextBlock FontSize="11"
                                                           Foreground="White"
                                                           Text="当前" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12">
                                            <TextBlock Classes="status"
                                                       Text="{Binding MaskedUid}" />
                                            <TextBlock Classes="status"
                                                       Text="{Binding RoomId, StringFormat='房间 {0}'}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <Button Content="切换"
                                                Command="{Binding SwitchCommand}"
                                                CommandParameter="{Binding Uid}" />
                                        <Button Content="退出"
                                                Command="{Binding LogoutCommand}"
                                                CommandParameter="{Binding Uid}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 扫码登录面板（未登录常驻，已登录收起） -->
            <Border Classes="dialog-card"
                    IsVisible="{Binding IsAddingAccount}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="扫码登录" />
                    <TextBlock Classes="status" Text="{Binding QrStatus}" />
                    <Border Width="216"
                            Height="216"
                            Padding="4"
                            CornerRadius="4"
                            Background="White"
                            HorizontalAlignment="Left">
                        <Panel>
                            <Image Stretch="Uniform"
                                   Source="{Binding QrImage}"
                                   IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="二维码不可用"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Panel>
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Classes="primary"
                                Content="生成 / 刷新二维码"
                                Command="{Binding BeginLoginCommand}" />
                        <Button Content="取消"
                                Command="{Binding CancelLoginCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
