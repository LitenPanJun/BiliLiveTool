<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BiliLiveTool.UI.Views;assembly=BiliLiveTool.UI"
             xmlns:vm="clr-namespace:BiliLiveTool.UI.ViewModels;assembly=BiliLiveTool.UI"
             x:Class="BiliLiveTool.App.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://BiliLiveTool.UI/Views/Dialog.axaml" />
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate x:DataType="vm:DialogViewModel">
            <views:DialogView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
