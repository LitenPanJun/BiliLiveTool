<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BiliLiveTool.UI\BiliLiveTool.UI.csproj" />
    <ProjectReference Include="..\BiliLiveTool.Services\BiliLiveTool.Services.csproj" />
    <ProjectReference Include="..\BiliLiveTool.Infrastructure\BiliLiveTool.Infrastructure.csproj" />
    <ProjectReference Include="..\BiliLiveTool.Core\BiliLiveTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 产品标识固定 BiliLiveTool：产物/可执行文件名不带工程后缀 -->
    <AssemblyName>BiliLiveTool</AssemblyName>
    <Product>BiliLiveTool</Product>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
